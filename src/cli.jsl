--!strict
--!native
-- Parser/dispatcher equivalents of the old loose *.jsl adapters.
-- Call require('@st4sh/scripts.cli').run(command, args).
local atlas = require '@st4sh/scripts.atlas'
local cod3x = require '@st4sh/scripts.cod3x'
local h3 = require '@st4sh/scripts.h3'
local menu = require '@st4sh/scripts.morrowind-ui'
local shuffle = require '@st4sh/scripts.morrowind-fucked'
local variants = require '@st4sh/scripts.material-variants'

local Cli = {}

--- What the generator behind a command answers.
export type Result =
  atlas.Result
  | h3.Header
  | h3.Logo
  | h3.ChromeSources
  | h3.Recomposed
  | menu.Result
  | { menu.Result }
  | shuffle.Result
  | cod3x.Hero
  | cod3x.Scope
  | cod3x.Mark
  | cod3x.All
  | variants.Result

--- The value that follows the switch at `index`, and where that value is.
local function need(args: { string }, index: number, flag: string): (string, number)
  local value = args[index + 1]

  if value == nil then error(flag .. ' needs a value', 2) end

  return value, index + 1
end

local function runAtlas(args: { string }): atlas.Result
  local options: atlas.Options = { mask = false, width = false, delete = false }
  local index = 1

  while index <= #args do
    local flag = args[index]

    if flag == '-i' or flag == '--input' then
      options.input, index = need(args, index, flag)
    elseif flag == '-o' or flag == '--output' then
      options.output, index = need(args, index, flag)
    elseif flag == '-r' or flag == '--rows' then
      local value

      value, index = need(args, index, flag)
      options.rows = tonumber(value)
    elseif flag == '-c' or flag == '--cols' then
      local value

      value, index = need(args, index, flag)
      options.cols = tonumber(value)
    elseif flag == '-m' or flag == '--mask' then
      options.mask = true
    elseif flag == '-w' or flag == '--width' then
      options.width = true
    elseif flag == '-d' or flag == '--delete' then
      options.delete = true
    else
      error('unknown option: ' .. tostring(flag), 2)
    end

    index += 1
  end

  return atlas.generate(options)
end

local function runHeader(args: { string }): h3.Header
  local target = args[1] or 'all'
  local options: h3.HeaderOptions = { crowbar = args[2] or 'crowbar.png' }

  if target == 'clean' then
    options.classified = false
  elseif target ~= 'all' and target ~= 'classified' then
    error('h3header [clean|classified|all] [crowbar.png]', 2)
  end

  return h3.generateHeader(options)
end

local function runLogo(args: { string }): h3.Logo
  return h3.generateLogo { target = args[1] or 'all', crowbar = args[2] or 'crowbar.png', output = args[3] or 'out' }
end

local function runChromeSources(args: { string }): h3.ChromeSources
  local options: h3.ChromeOptions = { output = 'h3ui-textures', seed = 3301 }
  local index = 1

  while index <= #args do
    local flag = args[index]

    if flag == '-o' or flag == '--output' then
      options.output, index = need(args, index, flag)
    elseif flag == '--material' then
      options.material, index = need(args, index, flag)
    elseif flag == '--material-crop' then
      local value

      value, index = need(args, index, flag)

      local left, top = string.match(value, '^(-?%d+),(-?%d+)$')

      if not left then error('bad crop', 2) end

      options.cropX = tonumber(left)
      options.cropY = tonumber(top)
    elseif flag == '--seed' then
      local value

      value, index = need(args, index, flag)
      options.seed = tonumber(value)
    elseif flag == '-m' or flag == '--magick' then
      -- The ImageMagick the shell script was told to run: read, and not used.
      local _, after = need(args, index, flag)

      index = after
    else
      error('unknown option: ' .. tostring(flag), 2)
    end

    index += 1
  end

  return h3.generateChromeSources(options)
end

local function runRecompose(args: { string }): h3.Recomposed
  local options: h3.RecomposeOptions = { output = 'chrome-atlases' }
  local index = 1

  while index <= #args do
    local flag = args[index]

    if flag == '--h3ui' then
      options.h3ui, index = need(args, index, flag)
    elseif flag == '--morrowind' then
      options.morrowind, index = need(args, index, flag)
    elseif flag == '--openmw-textures' then
      options.openmw, index = need(args, index, flag)
    elseif flag == '-o' or flag == '--output' then
      options.output, index = need(args, index, flag)
    elseif flag == '-m' or flag == '--magick' then
      -- The ImageMagick the shell script was told to run: read, and not used.
      local _, after = need(args, index, flag)

      index = after
    else
      error('unknown option: ' .. tostring(flag), 2)
    end

    index += 1
  end

  return h3.recomposeChrome(options)
end

local function runMenu(args: { string }): menu.Result
  local options: menu.Options = { output = 'Textures' }
  local index = 1

  while index <= #args do
    local flag = args[index]

    if flag == '-p' or flag == '--primary' then
      options.primary, index = need(args, index, flag)
    elseif flag == '-s' or flag == '--secondary' then
      options.secondary, index = need(args, index, flag)
    elseif flag == '-t' or flag == '--tertiary' then
      options.tertiary, index = need(args, index, flag)
    elseif flag == '-f' or flag == '--font' then
      options.font, index = need(args, index, flag)
    elseif flag == '-pts' or flag == '--primary-text-size' then
      local value

      value, index = need(args, index, flag)
      options.primarySize = tonumber(value)
    elseif flag == '-sts' or flag == '--secondary-text-size' then
      local value

      value, index = need(args, index, flag)
      options.secondarySize = tonumber(value)
    elseif flag == '-pk' or flag == '--primary-kerning' or flag == '-sk' or flag == '--secondary-kerning' then
      local value

      value, index = need(args, index, flag)

      if tonumber(value) ~= 0.75 then error('compiled font masks require kerning 0.75', 2) end
    elseif flag == '--seed' then
      local value

      value, index = need(args, index, flag)
      options.seed = tonumber(value)
    elseif flag == '-o' or flag == '--output' then
      options.output, index = need(args, index, flag)
    else
      error('unknown parameter: ' .. tostring(flag), 2)
    end

    index += 1
  end

  return menu.generate(options)
end

local function runVariants(args: { string }): variants.Result
  local stems: { string } = {}
  local options: variants.Options = { stems = stems }
  local index = 1

  while index <= #args do
    local flag = args[index]

    if flag == '--materials' then
      options.materials, index = need(args, index, flag)
    elseif flag == '--source-dir' then
      options.sourceDir, index = need(args, index, flag)
    elseif flag == '--install-dir' then
      options.installDir, index = need(args, index, flag)
    elseif flag == '--static-dir' then
      options.staticDir, index = need(args, index, flag)
    elseif flag == '--site-data' then
      options.siteData, index = need(args, index, flag)
    elseif flag == '--work-dir' then
      options.workDir, index = need(args, index, flag)
    elseif flag == '--random-crop' then
      options.randomCrop = true
    elseif flag == '--material-crop' then
      local value

      value, index = need(args, index, flag)

      local left, top = string.match(value, '^(-?%d+),(-?%d+)$')

      if not left then error('bad crop', 2) end

      options.materialCrop = { tonumber(left) :: number, tonumber(top) :: number }
    elseif flag == '--seed' then
      local value

      value, index = need(args, index, flag)
      options.seed = tonumber(value)
    elseif flag == '-m' or flag == '--magick' then
      -- The ImageMagick the shell script was told to run: read, and not used.
      local _, after = need(args, index, flag)

      index = after
    elseif string.sub(flag, 1, 1) == '-' then
      error('unknown option: ' .. tostring(flag), 2)
    else
      table.insert(stems, flag)
    end

    index += 1
  end

  return variants.build(options)
end

function Cli.run(command: string, args: { string }?): Result
  local given = args or {}

  if command == 'atlas' then return runAtlas(given) end
  if command == 'h3header' then return runHeader(given) end
  if command == 'h3logo' then return runLogo(given) end
  if command == 'h3ui' or command == 'generate-h3ui-textures' then return runChromeSources(given) end
  if command == 'recompose-chrome' then return runRecompose(given) end
  if command == 'morrowind-menu' then return runMenu(given) end

  if command == 'morrowind-all' then
    return menu.generateAll(given[1] or '.', { seed = tonumber(given[2] or '') or 0x4A455353 })
  end

  if command == 'morrowind-fucked' then return shuffle.shuffle { seed = tonumber(given[1] or '') or 0x4655434B } end
  if command == 'cod3x-hero' then return cod3x.generateHero { output = given[1] or '.' } end
  if command == 'cod3x-scope' then return cod3x.generateScope { output = given[1] or '.' } end
  if command == 'cod3x-mark' then return cod3x.generateMark { output = given[1] or '.' } end
  if command == 'cod3x-all' then return cod3x.generateAll { output = given[1] or '.' } end
  if command == 'material-variants' or command == 'build-material-variants' then return runVariants(given) end

  error('unknown st4sh script command: ' .. tostring(command), 2)
end

return Cli
