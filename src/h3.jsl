--!strict
--!optimize 2
-- H3 artwork: the header and the logo, the H3UI chrome sources made from a photographed
-- material, and the chrome atlases recomposed from those sources or from a Morrowind theme.
local dataPlane = require '@dream/data'
local magick = require '@magick'
local masks = require '@st4sh/scripts.h3-masks'

local H3 = {}

type Image = magick.Image
type Color = magick.Color
type Source = magick.Source
type Point = { number }

--- The crowbar's picture, where the clean header and the classified one are written
--- (`nexusHeaderClean.png` and `nexusHeader.png` where the process stands, when not given), and
--- the seed of the classified one's dust and noise. Only `classified = false` stops at the clean
--- header.
export type HeaderOptions = {
  crowbar: string?,
  cleanOutput: string?,
  output: string?,
  classified: boolean?,
  seed: number?,
}

export type Header = { clean: string, classified: string?, width: number?, height: number? }

--- The crowbar's picture, the folder the logo is written into (`out` when not given), which of
--- `clean`, `classified`, `icon` or `all` is made, and the seed of the classified badge's dust
--- and noise.
export type LogoOptions = { crowbar: string?, output: string?, target: string?, seed: number? }

export type Logo = { clean: string?, classified: string?, icon: string? }

--- The material's picture, the folder the sources are written under (`h3ui-textures` when not
--- given), where the square taken from the material starts, and the seed of the meter's noise.
export type ChromeOptions = { material: string?, output: string?, cropX: number?, cropY: number?, seed: number? }

export type ChromeSources = { output: string, cropX: number, cropY: number, files: number }

--- A folder of H3UI chrome sources, a folder of a Morrowind theme's textures, or both; the
--- folder the theme's scroll arrows are in when it is another; and the folder the atlases are
--- written under (`chrome-atlases` when not given).
export type RecomposeOptions = { h3ui: string?, morrowind: string?, openmw: string?, output: string? }

export type Recomposed = { manifest: string, output: string, h3ui: string?, morrowind: string? }

--- A piece of chrome: the file its H3UI source is, the size that source has, the border it is
--- drawn with, and where it lies in the atlas.
type Piece = { file: string, width: number, height: number, border: number, left: number, top: number }

--- The pieces a theme is recomposed from, and where its atlas is installed.
type Theme = { images: { [string]: Image }, borders: { [string]: number }, path: string }

local Ivory = '#e8e1d2'
local Paper = '#cfc6bc'
local Ink = '#050505'
local Purple = '#5c2a75'

--- The color of what a cover keeps: opaque white.
local Kept = '#ffffffff'

--- The panel the header's letters are kept inside.
local HeaderPanel: { Point } = { { 880, 119 }, { 1216, 122 }, { 1221, 275 }, { 890, 278 } }

--- The panel the badge's letters are kept inside.
local BadgePanel: { Point } = { { 265, 305 }, { 1305, 300 }, { 1318, 1112 }, { 282, 1124 } }

--- The panel the icon's letters are kept inside.
local IconPanel: { Point } = { { 92, 98 }, { 406, 94 }, { 412, 402 }, { 98, 412 } }

--- The two triangles of each scroll arrow, the outer and then the inner, on a square of 16.
local Arrows: { [string]: { { Point } } } = {
  up = { { { 1.5, 12.5 }, { 8, 2 }, { 14.5, 12.5 } }, { { 3.5, 11.5 }, { 8, 4.5 }, { 12.5, 11.5 } } },
  down = { { { 1.5, 3.5 }, { 8, 14 }, { 14.5, 3.5 } }, { { 3.5, 4.5 }, { 8, 11.5 }, { 12.5, 4.5 } } },
  left = { { { 12.5, 1.5 }, { 2, 8 }, { 12.5, 14.5 } }, { { 11.5, 3.5 }, { 4.5, 8 }, { 11.5, 12.5 } } },
  right = { { { 3.5, 1.5 }, { 14, 8 }, { 3.5, 14.5 } }, { { 4.5, 3.5 }, { 11.5, 8 }, { 4.5, 12.5 } } },
}

local Pieces: { [string]: Piece } = {
  thick = { file = 'frame_thick.dds', width = 512, height = 512, border = 4, left = 0, top = 0 },
  thin = { file = 'frame_thin.dds', width = 504, height = 504, border = 2, left = 4, top = 4 },
  button = { file = 'frame_button.dds', width = 136, height = 24, border = 4, left = 56, top = 56 },
  caption = { file = 'frame_caption.dds', width = 260, height = 20, border = 2, left = 56, top = 160 },
  pinUp = { file = 'frame_pin_up.dds', width = 20, height = 20, border = 2, left = 328, top = 56 },
  pinDown = { file = 'frame_pin_down.dds', width = 20, height = 20, border = 2, left = 400, top = 56 },
  scrollUp = { file = 'arrow_up.dds', width = 16, height = 16, border = 0, left = 320, top = 128 },
  scrollDown = { file = 'arrow_down.dds', width = 16, height = 16, border = 0, left = 356, top = 128 },
  scrollLeft = { file = 'arrow_left.dds', width = 16, height = 16, border = 0, left = 392, top = 128 },
  scrollRight = { file = 'arrow_right.dds', width = 16, height = 16, border = 0, left = 428, top = 128 },
}

--- The pieces laid over the thick frame, which fills the atlas, in the order they are laid.
local Inlaid = {
  'thin',
  'button',
  'caption',
  'pinUp',
  'pinDown',
  'scrollUp',
  'scrollDown',
  'scrollLeft',
  'scrollRight',
}

--- The frames a manifest lists, with the thickness each is drawn at and whether its center is.
local Frames = {
  { key = 'thin', thickness = 2, center = 'false' },
  { key = 'thick', thickness = 4, center = 'false' },
  { key = 'button', thickness = 4, center = 'false' },
  { key = 'caption', thickness = 2, center = 'true' },
  { key = 'pinUp', thickness = 2, center = 'true' },
  { key = 'pinDown', thickness = 2, center = 'true' },
}

--- The scroll arrows a manifest lists, each with the piece it is.
local Scrolls = {
  { direction = 'up', key = 'scrollUp' },
  { direction = 'down', key = 'scrollDown' },
  { direction = 'left', key = 'scrollLeft' },
  { direction = 'right', key = 'scrollRight' },
}

--- The formats a source of chrome may be in, the first found taken.
local SourceExtensions = { 'dds', 'bmp', 'tga', 'png' }

local ManifestHeader = [[
-- Generated by recompose_chrome_atlases.sh.
local util = require 'openmw.util'

local function region(path, x, y, width, height, sourceBorder, thickness, center, tintable)
  return {
    path = path,
    offset = util.vector2(x, y),
    size = util.vector2(width, height),
    sourceBorder = sourceBorder,
    thickness = thickness,
    center = center,
    tintable = tintable,
  }
end

return {]]

local function ensureDir(path: string)
  if not jess.fs.exists(path) then
    jess.fs.createDir(path)
  elseif not jess.fs.isDir(path) then
    error(path .. ' exists and is not a directory', 2)
  end
end

--- An image of a color with the coverage of one of the package's masks as its alpha.
local function lettering(name: string, color: Color): Image
  return magick.maskToImage(masks.get(name), color)
end

--- A clear image with a polygon filled in a color.
local function polygonImage(width: number, height: number, points: { Point }, color: Color): Image
  local out = magick.new(width, height)

  out:polygon(points, color)

  return out
end

--- The letters of a mask in ivory, kept inside a panel, and a copy of them kept inside
--- rectangles too: the letters that stay in front of the crowbar.
local function panelLetters(
  name: string,
  width: number,
  height: number,
  panel: { Point },
  fronts: { { number } }
): (Image, Image)
  local letters = lettering(name, Ivory)

  letters:copyAlpha(polygonImage(width, height, panel, Kept), 'dstin')

  local front, cover = letters:clone(), magick.new(width, height)

  for _, corners in fronts do
    cover:rect(corners[1], corners[2], corners[3], corners[4], Kept)
  end

  front:copyAlpha(cover, 'dstin')

  return letters, front
end

--- Specks of ivory on nothing: noise from a seed, what of it passes a threshold kept, at an
--- alpha; the threshold and the alpha are percentages.
local function dust(width: number, height: number, threshold: number, alpha: number, seed: number): Image
  local specks = magick.randomNoise(width, height, seed):threshold(threshold / 100)

  specks:transparent('#000000'):opaque('#ffffff', Ivory):setAlpha(alpha / 100)

  return specks
end

local function headerClean(crowbarPath: string): Image
  local width, height = 1300, 372
  local out = magick.new(width, height, '#090909')

  out:strokeRect(10, 10, 1290, 362, Ivory, 2)
  out:strokeRect(25, 25, 1275, 347, Ivory, 1)
  out:line(54, 91, 1246, 91, Ivory, 1)
  out:line(54, 314, 1246, 314, Ivory, 1)
  out:over(lettering('header.left_text', Ivory))
  out:polygonOver({ { 860, 100 }, { 1235, 104 }, { 1241, 294 }, { 872, 298 } }, Paper)
  out:polygonOver(HeaderPanel, Ink)

  local letters, front = panelLetters('header.h3_full', width, height, HeaderPanel, { { 968, 94, 1016, 198 } })
  local crowbar = magick.read(crowbarPath):resizeFit(205, 255):rotate(-5)

  out:over(letters)
  out:over(magick.shadowed(crowbar, 30, 3, 3, 4), 1015, 70)
  out:over(front)

  return out
end

function H3.generateHeader(options: HeaderOptions?): Header
  local settings: HeaderOptions = options or {}
  local crowbar = assert(settings.crowbar, 'h3-tools: crowbar path required')
  local clean = headerClean(crowbar)
  local cleanPath = settings.cleanOutput or 'nexusHeaderClean.png'

  magick.write(cleanPath, clean)

  if settings.classified == false then return { clean = cleanPath } end

  local seed = settings.seed or 3301
  local out = clean:clone()
  local approved = lettering('header.approved', Purple)

  out:over(approved, 57, out.height - approved.height - 66)
  out:over(dust(out.width, out.height, 86, 6, seed), 0, 0)
  out = magick.addGaussianNoise(out, seed + 1, 0.012)

  local classifiedPath = settings.output or 'nexusHeader.png'

  magick.write(classifiedPath, out)

  return { clean = cleanPath, classified = classifiedPath, width = out.width, height = out.height }
end

local function logoClean(crowbarPath: string): Image
  local width, height = 1600, 1600
  local out = magick.new(width, height, '#0a0a0a')

  out:strokeRect(48, 48, 1552, 1552, Ivory, 4)
  out:strokeRect(78, 78, 1522, 1522, Ivory, 2)
  out:line(120, 195, 1480, 195, Ivory, 2)
  out:line(120, 1410, 1480, 1410, Ivory, 2)
  out:strokeRect(210, 265, 1390, 1170, Ivory, 2)
  out:over(lettering('logo.text', Ivory))
  out:over(polygonImage(width, height, { { 230, 275 }, { 1335, 272 }, { 1352, 1145 }, { 248, 1158 } }, Paper))
  out:over(polygonImage(width, height, BadgePanel, Ink))

  local fronts = { { 400, 470, 640, 955 }, { 900, 470, 1105, 625 }, { 835, 770, 1115, 1010 } }
  local letters, front = panelLetters('logo.h3_full', width, height, BadgePanel, fronts)
  local crowbar = magick.read(crowbarPath):resizeFit(1080, 1080):rotate(-4)

  out:over(letters)
  out:over(magick.shadowed(crowbar, 40, 5, 5, 7), 250, 210)
  out:over(front)

  return out
end

--- The clean badge stamped, noted in purple, dusted and made noisy, from a seed.
local function logoClassified(clean: Image, seed: number): Image
  local out = clean:clone()
  local stamp = lettering('logo.stamp', '#8f1d2c')
  local note = lettering('logo.purple_note', Purple)

  out:over(stamp, math.floor((out.width - stamp.width) / 2), math.floor((out.height - stamp.height) / 2) - 5)
  out:over(note, 100, out.height - note.height - 115)
  out:over(dust(out.width, out.height, 82, 10, seed), 0, 0)

  return magick.addGaussianNoise(out, seed + 1, 0.02)
end

local function logoIcon(crowbarPath: string): Image
  local width, height = 512, 512
  local out = magick.new(width, height)

  out:rect(18, 18, 494, 494, '#0a0a0a')
  out:strokeRect(18, 18, 494, 494, Ivory, 3)
  out:strokeRect(30, 30, 482, 482, Ivory, 2)
  out:polygonOver({ { 70, 80 }, { 430, 78 }, { 436, 420 }, { 76, 430 } }, Paper)
  out:polygonOver(IconPanel, Ink)

  local fronts = { { 125, 125, 210, 310 }, { 285, 128, 378, 184 }, { 255, 270, 404, 365 } }
  local letters, front = panelLetters('logo.icon_h3_full', width, height, IconPanel, fronts)
  local crowbar = magick.read(crowbarPath):resizeFit(345, 345):rotate(-4)

  out:over(letters)
  out:over(crowbar, 78, 58)
  out:over(front)

  return out
end

function H3.generateLogo(options: LogoOptions?): Logo
  local settings: LogoOptions = options or {}
  local crowbar = assert(settings.crowbar, 'h3-tools: crowbar path required')
  local folder = settings.output or 'out'

  ensureDir(folder)

  local target = settings.target or 'all'
  local result: Logo = {}

  if target == 'clean' or target == 'classified' or target == 'all' then
    local clean = logoClean(crowbar)
    local cleanPath = jess.fs.join(folder, 'h3_badge_clean_v6.png')

    magick.write(cleanPath, clean)
    result.clean = cleanPath

    if target ~= 'clean' then
      local classifiedPath = jess.fs.join(folder, 'h3_badge_classified_v6.png')

      magick.write(classifiedPath, logoClassified(clean, settings.seed or 3301))
      result.classified = classifiedPath
    end
  end

  if target == 'icon' or target == 'all' then
    local iconPath = jess.fs.join(folder, 'h3_icon_v6.png')

    magick.write(iconPath, logoIcon(crowbar))
    result.icon = iconPath
  end

  return result
end

--- A gray copy of a material with its levels pressed between two percentages of white.
local function toned(material: Image, low: number, high: number): Image
  return material:clone():polynomial((high - low) / 100, low / 100):grayscale()
end

--- Shades a piece as raised: lit along the top and the left of its border, shadowed along the
--- bottom and the right, with a groove where the border ends.
local function shadeRaised(piece: Image, width: number, height: number, margin: number, strength: number)
  local right, bottom = width - 1, height - 1
  local inner, innerRight, innerBottom = margin - 1, width - margin, height - margin
  local light: Color = { 255, 255, 255, 0.22 * strength / 100 * 255 }
  local dark: Color = { 0, 0, 0, 0.28 * strength / 100 * 255 }
  local grooveDark: Color = { 0, 0, 0, 0.20 * strength / 100 * 255 }
  local grooveLight: Color = { 255, 255, 255, 0.20 * strength / 100 * 255 }

  piece:rectOver(0, 0, right, margin - 1, light)
  piece:rectOver(0, margin, margin - 1, innerBottom - 1, light)
  piece:rectOver(0, innerBottom, right, bottom, dark)
  piece:rectOver(innerRight, margin, right, innerBottom - 1, dark)
  piece:rectOver(inner, inner, innerRight, inner, grooveDark)
  piece:rectOver(inner, inner + 1, inner, innerBottom, grooveDark)
  piece:rectOver(margin, innerBottom, innerRight, innerBottom, grooveLight)
  piece:rectOver(innerRight, margin, innerRight, innerBottom - 1, grooveLight)
end

--- Shades a piece as lowered: its outermost pixels set to its median gray and then shadowed all
--- round, or, when it is recessed, shadowed along the top and the left and lit along the others.
local function shadeLowered(piece: Image, width: number, height: number, strength: number, recessed: boolean)
  local right, bottom = width - 1, height - 1
  local face = piece:median()
  local flat: Color = { face, face, face, 255 }
  local dark: Color = { 0, 0, 0, 0.25 * strength / 100 * 255 }

  piece:rect(0, 0, right, 0, flat)
  piece:rect(0, bottom, right, bottom, flat)
  piece:rect(0, 1, 0, bottom - 1, flat)
  piece:rect(right, 1, right, bottom - 1, flat)

  if recessed then
    local light: Color = { 255, 255, 255, 0.20 * strength / 100 * 255 }

    piece:rectOver(0, 0, right, 0, dark)
    piece:rectOver(0, 1, 0, bottom - 1, dark)
    piece:rectOver(0, bottom, right, bottom, light)
    piece:rectOver(right, 1, right, bottom - 1, light)

    return
  end

  piece:rectOver(0, 0, right, 0, dark)
  piece:rectOver(0, bottom, right, bottom, dark)
  piece:rectOver(0, 1, 0, bottom - 1, dark)
  piece:rectOver(right, 1, right, bottom - 1, dark)
end

--- Shades a piece evenly: its border darkened all round, and darkened again along the lines
--- where the border ends.
local function shadeUniform(piece: Image, width: number, height: number, margin: number, strength: number)
  local right, bottom = width - 1, height - 1
  local inner, innerRight, innerBottom = margin - 1, width - margin, height - margin
  local dark: Color = { 0, 0, 0, 0.25 * strength / 100 * 255 }

  piece:rectOver(0, 0, right, margin - 1, dark)
  piece:rectOver(0, innerBottom, right, bottom, dark)
  piece:rectOver(0, margin, margin - 1, innerBottom - 1, dark)
  piece:rectOver(innerRight, margin, right, innerBottom - 1, dark)
  piece:rectOver(0, inner, right, inner, dark)
  piece:rectOver(0, innerBottom, right, innerBottom, dark)
  piece:rectOver(inner, margin, inner, innerBottom - 1, dark)
  piece:rectOver(innerRight, margin, innerRight, innerBottom - 1, dark)
end

--- A frame of two tiles, the inner one set in from the edge by a band, shaded, with everything
--- inside its margin made clear.
@native
local function twoTone(
  width: number,
  height: number,
  margin: number,
  band: number,
  outerTile: Source,
  innerTile: Source,
  shading: string
): Image
  local piece = magick.tile(width, height, outerTile)

  piece:over(magick.tile(width - band * 2, height - band * 2, innerTile), band, band)

  if shading == 'raised' then
    shadeRaised(piece, width, height, margin, 100)
  else
    shadeUniform(piece, width, height, margin, 100)
  end

  local span = width - margin * 2

  if span > 0 then
    for row = margin, height - margin - 1 do
      dataPlane.fill(piece.data, 'u8@4+3', (row * width + margin) * 4, span, 0)
    end
  end

  return piece
end

--- A piece of three tiles, one inside the other: the inner set in by a band, the center by the
--- margin, shaded.
local function filled(
  width: number,
  height: number,
  margin: number,
  band: number,
  outerTile: Source,
  innerTile: Source,
  centerTile: Source,
  shading: string,
  strength: number
): Image
  local piece = magick.tile(width, height, outerTile)

  piece:over(magick.tile(width - band * 2, height - band * 2, innerTile), band, band)
  piece:over(magick.tile(width - margin * 2, height - margin * 2, centerTile), margin, margin)

  if shading == 'recessed' then
    shadeLowered(piece, width, height, strength, true)
  elseif shading == 'lowered' then
    shadeLowered(piece, width, height, strength, false)
  else
    shadeRaised(piece, width, height, margin, strength)
  end

  return piece
end

function H3.generateChromeSources(options: ChromeOptions?): ChromeSources
  local settings: ChromeOptions = options or {}
  local materialPath = assert(settings.material, 'h3-tools: --material path required')
  local output = settings.output or 'h3ui-textures'
  local size, seed = 512, settings.seed or 3301

  ensureDir(output)

  local textures = jess.fs.join(output, 'Textures')

  ensureDir(textures)
  textures = jess.fs.join(textures, 'h3ui')
  ensureDir(textures)

  local material = magick.read(materialPath)
  local cropSize = math.min(1024, material.width, material.height)
  local cropX, cropY = settings.cropX or 0, settings.cropY or 0

  if cropX < 0 or cropY < 0 or cropX + cropSize > material.width or cropY + cropSize > material.height then
    error('material crop does not fit image', 2)
  end

  local field = material:crop(cropSize, cropSize, cropX, cropY):grayscale():resize(size, size):grayscale()
  local composed = magick.mathCompose(field, magick.gaussianBlur(field, 12), 0, 1, -1, 0.5)

  field = composed:contrastStretch(1, 1):grayscale():sigmoidalContrast(2, 0.5):grayscale()

  local frameOuter, controlOuter = toned(field, 50, 100), toned(field, 48, 96)
  local controlInner, controlPressed = toned(field, 56, 100), toned(field, 30, 68)

  local function write(name: string, image: Image)
    magick.write(jess.fs.join(textures, name), image)
  end

  write('frame_thick.dds', twoTone(512, 512, 4, 2, frameOuter, frameOuter, 'uniform'))
  write('frame_thin.dds', twoTone(504, 504, 2, 1, frameOuter, frameOuter, 'uniform'))
  write('frame_button.dds', twoTone(136, 24, 4, 2, controlOuter, controlOuter, 'raised'))
  write('frame_caption.dds', filled(260, 20, 2, 1, frameOuter, frameOuter, frameOuter, 'lowered', 160))
  write('frame_pin_up.dds', filled(20, 20, 2, 1, controlInner, controlInner, controlOuter, 'raised', 140))
  write('frame_pin_down.dds', filled(20, 20, 2, 1, controlInner, controlInner, controlPressed, 'recessed', 140))

  for direction, triangles in Arrows do
    local arrow = magick.new(16, 16)

    arrow:polygon(triangles[1], controlInner)
    arrow:polygon(triangles[2], controlOuter)
    write('arrow_' .. direction .. '.dds', arrow)
  end

  local gradient = magick.verticalGradient(16, 8, { 245, 245, 245, 255 }, { 92, 92, 92, 255 })

  write('meter_fill.dds', magick.addGaussianNoise(gradient, seed + 20, 0.035):grayscale())
  write('flat_white.dds', magick.new(8, 8, '#ffffff'))

  return { output = textures, cropX = cropX, cropY = cropY, files = 12 }
end

--- The file a source of chrome is in, whichever of the formats it is found in first.
local function findSource(directory: string, basename: string): string?
  for _, extension in SourceExtensions do
    local path = jess.fs.join(directory, basename .. '.' .. extension)

    if jess.fs.exists(path) then return path end
  end

  return nil
end

local function findCornerSource(directory: string, prefix: string, corner: string): string?
  return findSource(directory, prefix .. '_' .. corner .. '_corner') or findSource(directory, prefix .. '_' .. corner)
end

local function findScrollSource(directory: string, direction: string): string?
  return findSource(directory, 'menu_scroll_' .. direction) or findSource(directory, 'omw_menu_scroll_' .. direction)
end

--- A texture of a Morrowind theme, brightened by half and drained of its color.
local function grayMorrowind(path: string): Image
  return magick.modulate(magick.read(path), 150, 0)
end

--- A frame of a size composed from a Morrowind theme's corners and sides, and from its center
--- when one is named, with the width of its border.
local function composeLegacyFrame(
  directory: string,
  prefix: string,
  targetWidth: number,
  targetHeight: number,
  centerName: string?
): (Image, number)
  local topLeftPath = assert(findCornerSource(directory, prefix, 'top_left'), 'missing ' .. prefix .. ' top_left')
  local topRightPath = assert(findCornerSource(directory, prefix, 'top_right'), 'missing ' .. prefix .. ' top_right')
  local bottomLeftPath =
    assert(findCornerSource(directory, prefix, 'bottom_left'), 'missing ' .. prefix .. ' bottom_left')
  local bottomRightPath =
    assert(findCornerSource(directory, prefix, 'bottom_right'), 'missing ' .. prefix .. ' bottom_right')
  local topPath = assert(findSource(directory, prefix .. '_top'), 'missing ' .. prefix .. ' top')
  local bottomPath = assert(findSource(directory, prefix .. '_bottom'), 'missing ' .. prefix .. ' bottom')
  local leftPath = assert(findSource(directory, prefix .. '_left'), 'missing ' .. prefix .. ' left')
  local rightPath = assert(findSource(directory, prefix .. '_right'), 'missing ' .. prefix .. ' right')
  local topLeft, topRight = grayMorrowind(topLeftPath), grayMorrowind(topRightPath)
  local bottomLeft, bottomRight = grayMorrowind(bottomLeftPath), grayMorrowind(bottomRightPath)
  local top, bottom = grayMorrowind(topPath), grayMorrowind(bottomPath)
  local left, right = grayMorrowind(leftPath), grayMorrowind(rightPath)
  local leftWidth, topHeight = topLeft.width, topLeft.height
  local rightWidth, bottomHeight = topRight.width, bottomLeft.height

  if leftWidth ~= topHeight or rightWidth ~= leftWidth or bottomHeight ~= topHeight then
    error('non-uniform source borders are not supported for ' .. prefix, 2)
  end

  local centerWidth, centerHeight = targetWidth - leftWidth - rightWidth, targetHeight - topHeight - bottomHeight

  if centerWidth <= 0 or centerHeight <= 0 then error('target too small for ' .. prefix, 2) end

  local out = magick.new(targetWidth, targetHeight)

  out:over(topLeft, 0, 0)
  out:over(top:resize(centerWidth, topHeight), leftWidth, 0)
  out:over(topRight, targetWidth - rightWidth, 0)
  out:over(left:resize(leftWidth, centerHeight), 0, topHeight)
  out:over(right:resize(rightWidth, centerHeight), targetWidth - rightWidth, topHeight)
  out:over(bottomLeft, 0, targetHeight - bottomHeight)
  out:over(bottom:resize(centerWidth, bottomHeight), leftWidth, targetHeight - bottomHeight)
  out:over(bottomRight, targetWidth - rightWidth, targetHeight - bottomHeight)

  if centerName then
    local centerPath =
      assert(findSource(directory, prefix .. '_' .. centerName), 'missing ' .. prefix .. '_' .. centerName)

    out:over(grayMorrowind(centerPath):resize(centerWidth, centerHeight), leftWidth, topHeight)
  end

  return out, leftWidth
end

--- A frame composed at the size its own sources make: two corners and a side each way.
local function composeLegacyNatural(directory: string, prefix: string, centerName: string?): (Image, number)
  local topLeft = magick.read(assert(findCornerSource(directory, prefix, 'top_left')))
  local top = magick.read(assert(findSource(directory, prefix .. '_top')))
  local left = magick.read(assert(findSource(directory, prefix .. '_left')))
  local width, height = topLeft.width + top.width + topLeft.width, topLeft.height + left.height + topLeft.height

  return composeLegacyFrame(directory, prefix, width, height, centerName)
end

--- The Lua a mod reads its chrome regions from: the themes recomposed, H3UI first.
local function manifest(themes: { [string]: Theme }): string
  local lines = { ManifestHeader }
  local names: { string } = {}

  if themes.h3ui then table.insert(names, 'h3ui') end
  if themes.morrowind then table.insert(names, 'morrowind') end

  for _, name in names do
    local theme = themes[name]

    table.insert(lines, '  ' .. name .. ' = {')
    table.insert(lines, '    frame = {')

    for _, frame in Frames do
      local piece, image = Pieces[frame.key], theme.images[frame.key]

      table.insert(
        lines,
        string.format(
          "      %s = region('%s', %d, %d, %d, %d, %d, %d, %s, true),",
          frame.key,
          theme.path,
          piece.left,
          piece.top,
          image.width,
          image.height,
          theme.borders[frame.key],
          frame.thickness,
          frame.center
        )
      )
    end

    table.insert(lines, '    },')
    table.insert(lines, '    scroll = {')

    for _, scroll in Scrolls do
      local piece, image = Pieces[scroll.key], theme.images[scroll.key]

      table.insert(
        lines,
        string.format(
          "      %s = region('%s', %d, %d, %d, %d, nil, nil, false, true),",
          scroll.direction,
          theme.path,
          piece.left,
          piece.top,
          image.width,
          image.height
        )
      )
    end

    table.insert(lines, '    },')
    table.insert(lines, '  },')
  end

  table.insert(lines, '}')
  table.insert(lines, '')

  return table.concat(lines, '\n')
end

-- Full H3UI + legacy Morrowind nested-atlas recomposer.
function H3.recomposeChrome(options: RecomposeOptions?): Recomposed
  local settings: RecomposeOptions = options or {}
  local h3ui, morrowind = settings.h3ui, settings.morrowind
  local openmw = settings.openmw

  if not h3ui and not morrowind then error('h3-tools: one of h3ui or morrowind is required', 2) end
  if morrowind and not openmw then openmw = morrowind end

  local output = settings.output or 'chrome-atlases'

  ensureDir(output)

  local textures = jess.fs.join(output, 'Textures')

  ensureDir(textures)
  textures = jess.fs.join(textures, 'h3ui')
  ensureDir(textures)

  local themes: { [string]: Theme } = {}

  if h3ui then
    local images: { [string]: Image }, borders: { [string]: number } = {}, {}

    for key, piece in Pieces do
      local basename = string.gsub(piece.file, '%.dds$', '')
      local path = assert(findSource(h3ui, basename), 'missing H3UI ' .. piece.file)
      local image = magick.read(path)

      if image.width ~= piece.width or image.height ~= piece.height then
        error(key .. ' source has wrong size', 2)
      end

      images[key] = image
      borders[key] = piece.border
    end

    themes.h3ui = { images = images, borders = borders, path = 'textures/h3ui/h3ui_chrome.dds' }
  end

  if morrowind then
    local images: { [string]: Image } = {}
    local borders: { [string]: number } = {}

    images.thick, borders.thick = composeLegacyFrame(morrowind, 'menu_thick_border', 512, 512, nil)
    images.thin, borders.thin = composeLegacyFrame(morrowind, 'menu_thin_border', 504, 504, nil)
    images.button, borders.button = composeLegacyNatural(morrowind, 'menu_button_frame', nil)
    images.caption, borders.caption = composeLegacyNatural(morrowind, 'menu_head_block', 'middle')
    images.pinUp, borders.pinUp = composeLegacyNatural(morrowind, 'menu_rightbuttonup', 'center')
    images.pinDown, borders.pinDown = composeLegacyNatural(morrowind, 'menu_rightbuttondown', 'center')

    for _, scroll in Scrolls do
      local path = assert(findScrollSource(openmw :: string, scroll.direction), 'missing scroll ' .. scroll.direction)

      images[scroll.key] = magick.read(path)
      borders[scroll.key] = 0
    end

    themes.morrowind = { images = images, borders = borders, path = 'textures/h3ui/morrowind_chrome.dds' }
  end

  for name, theme in themes do
    local atlas = magick.new(512, 512)

    atlas:over(theme.images.thick, 0, 0)

    for _, key in Inlaid do
      local image, piece = theme.images[key], Pieces[key]

      if piece.left + image.width > 512 or piece.top + image.height > 512 then
        error(name .. '/' .. key .. ' does not fit atlas', 2)
      end

      atlas:over(image, piece.left, piece.top)
    end

    magick.write(jess.fs.join(textures, name .. '_chrome.dds'), atlas)

    if name == 'morrowind' then
      local chrome = jess.fs.join(textures, 'chrome')

      ensureDir(chrome)
      jess.fs.copy(jess.fs.join(textures, 'morrowind_chrome.dds'), jess.fs.join(chrome, 'morrowind.dds'))
    end
  end

  local manifestPath = jess.fs.join(output, 'h3ui_chrome_manifest.lua')

  jess.fs.write(manifestPath, manifest(themes))

  return {
    manifest = manifestPath,
    output = textures,
    h3ui = if themes.h3ui then jess.fs.join(textures, 'h3ui_chrome.dds') else nil,
    morrowind = if themes.morrowind then jess.fs.join(textures, 'morrowind_chrome.dds') else nil,
  }
end

return H3
