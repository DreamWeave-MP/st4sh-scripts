function M.get(key)
    local row = packed[key]
    if not row then error("unknown bundled font mask: " .. key, 2) end
    return { width = row[1], height = row[2], data = bytes.inflate(bytes.fromBase64(row[3]), { maxSize = row[1] * row[2] }) }
end
function M.has(key) return packed[key] ~= nil end
