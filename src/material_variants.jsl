--!strict
--!optimize 2
-- Port of build_material_variants.sh. The catalog/source assets are caller-owned.
local fs = require '@dream/fs'
local h3 = require '@st4sh/scripts.h3'
local magick = require '@magick'

local Variants = {}

--- The catalog of materials, a TSV with a header line; the folder its photos are in; the folder
--- the chrome is installed under; and, when wanted, a folder for previews, a file for the site's
--- data, a folder to work in, the stems to build, a seed, and where every photo is cropped:
--- at `materialCrop`, or with `randomCrop` somewhere chosen from the seed, else where the catalog
--- says.
export type Options = {
  materials: string?,
  sourceDir: string?,
  installDir: string?,
  staticDir: string?,
  siteData: string?,
  workDir: string?,
  stems: { string }?,
  seed: number?,
  materialCrop: { number }?,
  randomCrop: boolean?,
}

export type Built = { stem: string, cropX: number, cropY: number, output: string }
export type Result = { built: { Built }, count: number }

--- A row of the catalog.
type Material = {
  stem: string,
  family: string,
  name: string,
  photo: string,
  cropX: number?,
  cropY: number?,
  url: string,
  author: string,
  license: string,
}

local function ensureTree(path: string)
  if fs.exists(path) then
    if not fs.isDir(path) then error(path .. ' exists and is not a directory', 2) end

    return
  end

  local parent = fs.parent(path)

  if parent and parent ~= path and parent ~= '' and not fs.exists(parent) then ensureTree(parent) end

  local done, problem = fs.mkdir(path, { recursive = true })
  if not done then error(problem, 0) end
end

local function splitTabs(line: string): { string }
  local columns: { string } = {}
  local from = 1

  while true do
    local tab = string.find(line, '\t', from, true)

    if not tab then
      table.insert(columns, string.sub(line, from))

      break
    end

    table.insert(columns, string.sub(line, from, tab - 1))
    from = tab + 1
  end

  return columns
end

--- A value as a JSON string, nothing for a value that is not there.
local function jsonString(value: string?): string
  local text = tostring(value or '')

  text = string.gsub(text, '\\', '\\\\')
  text = string.gsub(text, '"', '\\"')
  text = string.gsub(text, '\n', '\\n')
  text = string.gsub(text, '\r', '\\r')
  text = string.gsub(text, '\t', '\\t')

  return '"' .. text .. '"'
end

--- A Lehmer generator from a seed: `random(bound)` is in `0..bound-1`.
local function generator(seed: number?): (bound: number) -> number
  local state = (seed or 3301) % 2147483647

  if state <= 0 then state = 1 end

  return function(bound: number): number
    state = (state * 48271) % 2147483647

    return if bound <= 1 then 0 else state % bound
  end
end

--- The materials of a catalog, those with one of the stems `wanted` when `filter` is set: every
--- line after the first with nine columns or more, a line that is empty not counted as one.
local function catalog(materials: string, filter: boolean, wanted: { [string]: boolean }): { Material }
  local rows: { Material } = {}
  local lineNumber = 0
  -- A catalog that is not there is refused by `string.gmatch`, in its words.
  local text = fs.readFileString(materials) :: string

  for line in string.gmatch(text, '([^\r\n]+)') do
    lineNumber += 1

    if lineNumber == 1 then continue end

    local columns = splitTabs(line)

    if #columns < 9 then continue end

    local row: Material = {
      stem = columns[1],
      family = columns[2],
      name = columns[3],
      photo = columns[4],
      cropX = tonumber(columns[5]),
      cropY = tonumber(columns[6]),
      url = columns[7],
      author = columns[8],
      license = columns[9],
    }

    if not filter or wanted[row.stem] then table.insert(rows, row) end
  end

  return rows
end

function Variants.build(options: Options?): Result
  local settings: Options = options or {}
  local materials = assert(settings.materials, 'material variants: materials TSV required')
  local sourceDir = assert(settings.sourceDir, 'material variants: sourceDir required')
  local installDir = assert(settings.installDir, 'material variants: installDir required')
  local {stems, staticDir, siteData, materialCrop} = settings
  local wanted: { [string]: boolean } = {}

  if stems then
    for _, stem in stems do
      wanted[stem] = true
    end
  end

  local rows = catalog(materials, if stems then #stems > 0 else false, wanted)

  if #rows == 0 then error('No materials matched.', 2) end

  ensureTree(fs.join(installDir, 'chrome'))

  if staticDir then ensureTree(staticDir) end

  local random = generator(settings.seed or 3301)
  local built: { Built } = {}
  local work = settings.workDir or fs.join(installDir, '.st4sh-material-work')

  ensureTree(work)

  for _, row in rows do
    local material = fs.join(sourceDir, row.photo)
    local cropX, cropY = row.cropX or 0, row.cropY or 0

    if materialCrop then
      cropX, cropY = materialCrop[1], materialCrop[2]
    elseif settings.randomCrop then
      local photo = magick.read(material)
      local cropSize = math.min(1024, photo.width, photo.height)

      cropX = random(photo.width - cropSize + 1)
      cropY = random(photo.height - cropSize + 1)
    end

    local sources, atlases = fs.join(work, 'gen-' .. row.stem), fs.join(work, 'atlas-' .. row.stem)

    h3.generateChromeSources {
      material = material,
      cropX = cropX,
      cropY = cropY,
      output = sources,
      seed = settings.seed or 3301,
    }

    local recomposed = h3.recomposeChrome { h3ui = fs.join(sources, 'Textures', 'h3ui'), output = atlases }
    local atlas = recomposed.h3ui :: string
    local installed = fs.join(installDir, 'chrome', row.stem .. '.dds')

    local done, problem = fs.copy(atlas, installed)
    if not done then error(problem, 0) end

    -- Generic @magick has no WebP encoder yet; emit lossless PNG previews.
    if staticDir then magick.write(fs.join(staticDir, row.stem .. '.png'), magick.read(atlas)) end

    table.insert(built, { stem = row.stem, cropX = cropX, cropY = cropY, output = installed })
  end

  if siteData then
    local chunks = { '{\n  "materials": [\n' }

    for index, row in rows do
      if index > 1 then table.insert(chunks, ',\n') end

      table.insert(
        chunks,
        string.format(
          '    {"id": %s, "family": %s, "name": %s, "photo": %s, "crop": [%d, %d], "url": %s, "author": %s, "license": %s}',
          jsonString(row.stem),
          jsonString(row.family),
          jsonString(row.name),
          jsonString(row.photo),
          row.cropX or 0,
          row.cropY or 0,
          jsonString(row.url),
          jsonString(row.author),
          jsonString(row.license)
        )
      )
    end

    table.insert(chunks, '\n  ]\n}\n')

    local parent = fs.parent(siteData)

    if parent then ensureTree(parent) end

    local done, problem = fs.writeFile(siteData, table.concat(chunks), { atomic = true, createParents = true })
    if not done then error(problem, 0) end
  end

  return { built = built, count = #built }
end

return Variants
