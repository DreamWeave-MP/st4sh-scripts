--!strict
-- Generated alpha masks from the supplied fonts through native ImageMagick 7.1.2.
local bytes=require("@dream/bytes")
local packed={
  ["header.left_text"]={1300,372,""},
  ["header.h3_full"]={1300,372,""},
  ["header.approved"]={165,39,""},
  ["logo.text"]={1600,1600,""},
  ["logo.h3_full"]={1600,1600,""},
  ["logo.icon_h3_full"]={512,512,""},
  ["logo.stamp"]={831,305,""},
  ["logo.purple_note"]={286,52,""},
}
local M={} @native function M.get(name: string) local r=packed[name] if not r then error("unknown h3 mask: "..tostring(name),2) end local width,height=r[1] :: number,r[2] :: number return {width=width,height=height,data=bytes.inflate(bytes.fromBase64(r[3] :: string),{format="zlib",maxSize=width*height})} end return M
