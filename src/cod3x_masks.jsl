local bytes=require("@dream/bytes")
local packed={
  ["hero.meta"]={1300,372,""},
  ["hero.sub"]={1300,372,""},
  ["hero.tag"]={1300,372,""},
  ["hero.title"]={1300,372,""},
  ["mark.badge.c3"]={1600,1600,""},
