  ["scope.title"]={1300,900,""},
}
local M={}
function M.get(name) local r=packed[name] if not r then error("unknown COD3X mask: "..tostring(name),2) end return {width=r[1],height=r[2],data=bytes.inflate(bytes.fromBase64(r[3]),{format="zlib",maxSize=r[1]*r[2]})} end
return M
