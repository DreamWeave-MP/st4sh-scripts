  ["mark.badge.meta"]={1600,1600,""},
  ["mark.badge.name"]={1600,1600,""},
  ["mark.badge.tag"]={1600,1600,""},
  ["mark.icon.c3"]={512,512,""},
  ["mark.icon.name"]={512,512,""},
  ["mark.icon.tag"]={512,512,""},
  ["scope.card.detail.0"]={1300,900,""},
  ["scope.card.detail.1"]={1300,900,""},
  ["scope.card.detail.2"]={1300,900,""},
  ["scope.card.detail.3"]={1300,900,""},
